# SDAL Demo — environment configuration

# Ask (GE) surface: "canned" uses ./data/canned.json (no network, deterministic).
# "live" uses the Gemini API and requires GEMINI_API_KEY.
DEMO_MODE=canned

# Only needed when DEMO_MODE=live
GEMINI_API_KEY=

# SQLite database location (WAL). On Render this lives on the mounted disk.
SDAL_DB_PATH=./data/sdal.db

# Deterministic world seed. Same seed + same inputs => identical world.
SDAL_SEED=42
